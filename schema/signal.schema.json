{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://github.com/jaizendra-netizen/gtm-signal-schema/schema/signal.schema.json",
  "title": "GTM buying signal",
  "description": "One observed change at one company that may be a reason to reach out.",
  "type": "object",
  "required": ["signal_id", "type", "company", "detected_at", "source"],
  "additionalProperties": false,
  "properties": {
    "signal_id": { "type": "string", "minLength": 1, "pattern": "^[A-Za-z0-9._:-]+$" },
    "type": { "type": "string", "enum": ["hiring", "funding", "technology", "engagement", "leadership", "other"] },
    "company": {
      "type": "object",
      "required": ["domain"],
      "additionalProperties": false,
      "properties": {
        "name": { "type": "string", "minLength": 1 },
        "domain": { "type": "string", "pattern": "^[a-z0-9]([a-z0-9-]*[a-z0-9])?(\\.[a-z0-9]([a-z0-9-]*[a-z0-9])?)+$" },
        "linkedin_url": { "type": "string", "pattern": "^https://([a-z]{2,3}\\.)?linkedin\\.com/company/[^/?#]+/?$" }
      }
    },
    "detected_at": { "type": "string", "format": "date-time" },
    "source": {
      "type": "object",
      "required": ["provider"],
      "additionalProperties": false,
      "properties": {
        "provider": { "type": "string", "minLength": 1 },
        "url": { "type": "string", "pattern": "^https?://" }
      }
    },
    "summary": { "type": "string", "minLength": 1, "maxLength": 280 },
    "confidence": { "type": "number", "minimum": 0, "maximum": 1 },
    "evidence": { "type": "array", "items": { "type": "string", "minLength": 1 }, "minItems": 1 },
    "status": { "type": "string", "enum": ["new", "reviewed", "used", "discarded"] }
  }
}
